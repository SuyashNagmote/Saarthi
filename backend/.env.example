# Copy to .env OR run from repo root: node scripts/setup-env.mjs

# ── REQUIRED ────────────────────────────────────────────────
JWT_SECRET=generate-with-setup-script-or-openssl-rand-base64-48
JWT_REFRESH_SECRET=different-from-jwt-secret
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SQLite (default): backend/prisma/dev.db — no DATABASE_URL needed
# Postgres (optional): set in prisma/schema.prisma and uncomment:
# DATABASE_URL=postgresql://user:pass@localhost:5432/saarthi

# ── EMAIL (SMTP) — optional ───────────────────────────────
# Mailtrap (testing): mailtrap.io → Inbox → SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Saarthi Platform <noreply@saarthi.app>

# ── AZURE AD SSO — optional ────────────────────────────────
# portal.azure.com → Entra ID → App registrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ── TEAMS — optional ──────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ── OPENAI — optional ─────────────────────────────────────
OPENAI_API_KEY=

ESCALATION_SLA_HOURS=48
API_BASE_URL=http://localhost:3001/api/v1
